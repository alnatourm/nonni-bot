# Telegram
TELEGRAM_BOT_TOKEN=

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Change this whenever you want to switch models
GROQ_MODEL=llama-3.3-70b-versatile

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/nonni.db

# Nonni
DEFAULT_LANGUAGE=auto
MAX_HISTORY=20
MAX_MEMORY_ITEMS=50

# Limits
MAX_MESSAGE_LENGTH=12000
MAX_FILE_SIZE_MB=10

# Features
ENABLE_MEMORY=true
ENABLE_WEB_SEARCH=true
ENABLE_DOCUMENTS=true
ENABLE_VISION=true

LOG_LEVEL=INFO
