# Telegram
TELEGRAM_BOT_TOKEN=

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Change this whenever you want to switch models
GROQ_MODEL=openai/gpt-oss-120b

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/nonni.db

# Nonni
DEFAULT_LANGUAGE=auto
MAX_HISTORY=20
MAX_MEMORY_ITEMS=50

# Limits
MAX_MESSAGE_LENGTH=12000

# Reliability and access control
ENABLE_MEMORY=true
REQUESTS_PER_MINUTE=10
AI_TIMEOUT_SECONDS=75
AI_MAX_RETRIES=3

# Optional: leave blank for a public bot, or add comma-separated Telegram IDs
ALLOWED_USER_IDS=

LOG_LEVEL=INFO
